<?php

namespace App\Http\Controllers;

use App\Models\Medicine;
use App\Models\Category;
use App\Models\medicines;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;

class MedicineController extends Controller
{
    public function index(Request $request)
    {
        $query = medicines::with('category');

        if ($search = $request->query('q')) {
            $query->where(function ($q) use ($search) {
                $q->where('name', 'like', "%{$search}%")
                  ->orWhere('active_ingredient', 'like', "%{$search}%");
            });
        }

        if ($category = $request->query('category_id')) {
            $query->where('category_id', $category);
        }

        $medicines = $query->paginate(20);

        return $this->success('Medicines list.', $medicines);
    }

    public function show(int $id)
    {
        $medicine = medicines::with(['category', 'inventoryItems.pharmacy'])->findOrFail($id);
        return $this->success('Medicine details.', $medicine);
    }

    public function categories()
    {
        return $this->success('Categories.', Category::withCount('medicines')->get());
    }

    // ── Admin actions ──────────────────────────────────────────────────────────

    public function store(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'name'                   => 'required|string|max:255',
            'active_ingredient'      => 'required|string|max:255',
            'category_id'            => 'required|exists:categories,id',
            'description'            => 'nullable|string',
            'manufacturer'           => 'nullable|string|max:255',
            'requires_prescription'  => 'boolean',
            'image'                  => 'nullable|image|max:2048',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $data = $request->only([
            'name', 'active_ingredient', 'category_id',
            'description', 'manufacturer', 'requires_prescription',
        ]);

        if ($request->hasFile('image')) {
            $data['image'] = $request->file('image')->store('medicines', 'public');
        }

        $medicine = medicines::create($data);

        return $this->success('Medicine created.', $medicine, 201);
    }

    public function update(Request $request, int $id)
    {
        $medicine = medicines::findOrFail($id);

        $validator = Validator::make($request->all(), [
            'name'                   => 'sometimes|string|max:255',
            'active_ingredient'      => 'sometimes|string|max:255',
            'category_id'            => 'sometimes|exists:categories,id',
            'description'            => 'nullable|string',
            'manufacturer'           => 'nullable|string|max:255',
            'requires_prescription'  => 'boolean',
            'image'                  => 'nullable|image|max:2048',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $data = $request->only([
            'name', 'active_ingredient', 'category_id',
            'description', 'manufacturer', 'requires_prescription',
        ]);

        if ($request->hasFile('image')) {
            $data['image'] = $request->file('image')->store('medicines', 'public');
        }

        $medicine->update($data);

        return $this->success('Medicine updated.', $medicine);
    }

    public function destroy(int $id)
    {
        medicines::findOrFail($id)->delete();
        return $this->success('Medicine deleted.');
    }
}
