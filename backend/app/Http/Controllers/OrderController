<?php

namespace App\Http\Controllers;

use App\Models\Order;
use App\Models\InventoryItem;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;

class OrderController extends Controller
{
    public function index()
    {
        $user = auth('api')->user();

        if ($user->role === 'citizen') {
            $orders = Order::with(['pharmacy', 'inventoryItem.medicine'])
                ->where('citizen_id', $user->id)
                ->latest()
                ->paginate(20);
        } else {
            $pharmacy = $user->pharmacy;
            if (!$pharmacy) return $this->error('Pharmacy not found.', [], 404);

            $orders = Order::with(['citizen', 'inventoryItem.medicine'])
                ->where('pharmacy_id', $pharmacy->id)
                ->latest()
                ->paginate(20);
        }

        return $this->success('Orders.', $orders);
    }

    public function show(int $id)
    {
        $user  = auth('api')->user();
        $order = Order::with(['citizen', 'pharmacy', 'inventoryItem.medicine'])->findOrFail($id);

        if ($user->role === 'citizen' && $order->citizen_id !== $user->id) {
            return $this->error('Forbidden.', [], 403);
        }

        if ($user->role === 'pharmacy' && $order->pharmacy_id !== $user->pharmacy?->id) {
            return $this->error('Forbidden.', [], 403);
        }

        return $this->success('Order details.', $order);
    }

    public function store(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'inventory_item_id' => 'required|exists:inventory_items,id',
            'quantity'          => 'required|integer|min:1',
            'notes'             => 'nullable|string',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $item = InventoryItem::with('pharmacy')->findOrFail($request->inventory_item_id);

        if (!$item->is_available || $item->quantity < $request->quantity) {
            return $this->error('Insufficient stock or item unavailable.', [], 422);
        }

        $order = Order::create([
            'citizen_id'        => auth('api')->id(),
            'pharmacy_id'       => $item->pharmacy_id,
            'inventory_item_id' => $item->id,
            'quantity'          => $request->quantity,
            'total_price'       => $item->price * $request->quantity,
            'status'            => 'pending',
            'notes'             => $request->notes,
        ]);

        return $this->success('Order placed.', $order->load('inventoryItem.medicine', 'pharmacy'), 201);
    }

    public function updateStatus(Request $request, int $id)
    {
        $pharmacy = auth('api')->user()->pharmacy;
        if (!$pharmacy) return $this->error('Pharmacy not found.', [], 404);

        $order = Order::where('pharmacy_id', $pharmacy->id)->findOrFail($id);

        $validator = Validator::make($request->all(), [
            'status' => 'required|in:approved,ready,cancelled',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        // Guard valid transitions
        $allowed = [
            'pending'  => ['approved', 'cancelled'],
            'approved' => ['ready', 'cancelled'],
        ];

        if (!isset($allowed[$order->status]) || !in_array($request->status, $allowed[$order->status])) {
            return $this->error("Cannot transition from '{$order->status}' to '{$request->status}'.", [], 422);
        }

        $order->update(['status' => $request->status]);

        return $this->success('Order status updated.', $order);
    }

    public function destroy(int $id)
    {
        $order = Order::where('citizen_id', auth('api')->id())->findOrFail($id);

        if ($order->status !== 'pending') {
            return $this->error('Only pending orders can be cancelled.', [], 422);
        }

        $order->update(['status' => 'cancelled']);

        return $this->success('Order cancelled.');
    }
}
