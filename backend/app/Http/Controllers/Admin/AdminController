<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\{User, Pharmacy, Complaint, Medicine, Category, Order, BroadcastRequest, medicines};
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;
// ═══════════════════════════════════════════════════════════════════════════════
class UserManagementController extends Controller
{
    public function index(Request $request)
    {
        $query = User::query();

        if ($role = $request->query('role')) {
            $query->where('role', $role);
        }

        if ($search = $request->query('q')) {
            $query->where(function ($q) use ($search) {
                $q->where('name', 'like', "%{$search}%")
                  ->orWhere('email', 'like', "%{$search}%");
            });
        }

        return $this->success('Users.', $query->paginate(20));
    }

    public function updateStatus(Request $request, int $id)
    {
        $user = User::findOrFail($id);

        if ($user->role === 'admin') {
            return $this->error('Cannot modify admin accounts.', [], 403);
        }

        $validator = Validator::make($request->all(), [
            'is_active' => 'required|boolean',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $user->update(['is_active' => $request->is_active]);

        return $this->success('User status updated.', $user);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
class PharmacyVerificationController extends Controller
{
    public function pending()
    {
        $pharmacies = Pharmacy::with('user')
            ->where('is_verified', false)
            ->paginate(20);

        return $this->success('Pending verification.', $pharmacies);
    }

    public function verify(Request $request, int $id)
    {
        $pharmacy = Pharmacy::findOrFail($id);

        $validator = Validator::make($request->all(), [
            'is_verified' => 'required|boolean',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $pharmacy->update(['is_verified' => $request->is_verified]);

        $status = $request->is_verified ? 'verified' : 'rejected';

        return $this->success("Pharmacy {$status}.", $pharmacy);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
class AdminComplaintController extends Controller
{
    public function index(Request $request)
    {
        $query = Complaint::with(['citizen', 'pharmacy']);

        if ($status = $request->query('status')) {
            $query->where('status', $status);
        }

        return $this->success('Complaints.', $query->latest()->paginate(20));
    }

    public function update(Request $request, int $id)
    {
        $complaint = Complaint::findOrFail($id);

        $validator = Validator::make($request->all(), [
            'status'      => 'required|in:open,in_review,resolved,rejected',
            'admin_reply' => 'nullable|string',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $complaint->update($request->only('status', 'admin_reply'));

        return $this->success('Complaint updated.', $complaint);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
class StatisticsController extends Controller
{
    public function index()
    {
        $stats = [
            'users' => [
                'total'     => User::count(),
                'citizens'  => User::where('role', 'citizen')->count(),
                'pharmacies'=> User::where('role', 'pharmacy')->count(),
                'active'    => User::where('is_active', true)->count(),
            ],
            'pharmacies' => [
                'total'    => Pharmacy::count(),
                'verified' => Pharmacy::where('is_verified', true)->count(),
                'pending'  => Pharmacy::where('is_verified', false)->count(),
            ],
            'medicines' => [
                'total'      => medicines::count(),
                'categories' => Category::count(),
            ],
            'orders' => [
                'total'     => Order::count(),
                'pending'   => Order::where('status', 'pending')->count(),
                'approved'  => Order::where('status', 'approved')->count(),
                'ready'     => Order::where('status', 'ready')->count(),
                'cancelled' => Order::where('status', 'cancelled')->count(),
                'revenue'   => Order::whereIn('status', ['approved', 'ready'])->sum('total_price'),
            ],
            'broadcast_requests' => [
                'total'    => BroadcastRequest::count(),
                'open'     => BroadcastRequest::where('status', 'open')->count(),
                'accepted' => BroadcastRequest::where('status', 'accepted')->count(),
            ],
            'complaints' => [
                'total'    => Complaint::count(),
                'open'     => Complaint::where('status', 'open')->count(),
                'resolved' => Complaint::where('status', 'resolved')->count(),
            ],
        ];

        return $this->success('Platform statistics.', $stats);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
class ReportController extends Controller
{
    public function index(Request $request)
    {
        $period = $request->query('period', '30'); // days

        $from = now()->subDays((int) $period);

        $report = [
            'period_days'       => (int) $period,
            'new_users'         => User::where('created_at', '>=', $from)->count(),
            'new_orders'        => Order::where('created_at', '>=', $from)->count(),
            'revenue'           => Order::where('created_at', '>=', $from)
                ->whereIn('status', ['approved', 'ready'])
                ->sum('total_price'),
            'broadcast_requests'=> BroadcastRequest::where('created_at', '>=', $from)->count(),
            'top_medicines'     => \App\Models\InventoryItem::selectRaw(
                    'medicine_id, SUM(quantity) as total_stock'
                )
                ->with('medicine:id,name')
                ->groupBy('medicine_id')
                ->orderByDesc('total_stock')
                ->limit(10)
                ->get(),
            'shortage_alerts'   => \App\Models\InventoryItem::where('quantity', '<=', 5)
                ->where('is_available', true)
                ->with(['medicine:id,name', 'pharmacy:id,name'])
                ->get(),
        ];

        return $this->success('Platform report.', $report);
    }
}

