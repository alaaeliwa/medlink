<?php

namespace App\Http\Controllers;

use App\Models\InventoryItem;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Validator;

class InventoryController extends Controller
{
    private function pharmacy()
    {
        $pharmacy = auth('api')->user()->pharmacy;
        if (!$pharmacy) {
            abort(response()->json(['success' => false, 'message' => 'Pharmacy not found.'], 404));
        }
        return $pharmacy;
    }

    public function index()
    {
        $items = $this->pharmacy()
            ->inventoryItems()
            ->with('medicine.category')
            ->paginate(20);

        return $this->success('Inventory.', $items);
    }

    public function store(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'medicine_id'  => 'required|exists:medicines,id',
            'quantity'     => 'required|integer|min:0',
            'price'        => 'required|numeric|min:0',
            'expiry_date'  => 'required|date|after:today',
            'is_available' => 'boolean',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $pharmacy = $this->pharmacy();

        // Prevent duplicate entries for same medicine
        $existing = $pharmacy->inventoryItems()->where('medicine_id', $request->medicine_id)->first();
        if ($existing) {
            return $this->error('Medicine already in inventory. Update the existing entry.', [], 409);
        }

        $item = $pharmacy->inventoryItems()->create([
            'medicine_id'  => $request->medicine_id,
            'quantity'     => $request->quantity,
            'price'        => $request->price,
            'expiry_date'  => $request->expiry_date,
            'is_available' => $request->boolean('is_available', true),
        ]);

        return $this->success('Item added to inventory.', $item->load('medicine'), 201);
    }

    public function update(Request $request, int $id)
    {
        $item = $this->pharmacy()->inventoryItems()->findOrFail($id);

        $validator = Validator::make($request->all(), [
            'quantity'     => 'sometimes|integer|min:0',
            'price'        => 'sometimes|numeric|min:0',
            'expiry_date'  => 'sometimes|date|after:today',
            'is_available' => 'boolean',
        ]);

        if ($validator->fails()) {
            return $this->error('Validation failed.', $validator->errors(), 422);
        }

        $item->update($request->only('quantity', 'price', 'expiry_date', 'is_available'));

        return $this->success('Inventory item updated.', $item->load('medicine'));
    }

    public function destroy(int $id)
    {
        $this->pharmacy()->inventoryItems()->findOrFail($id)->delete();
        return $this->success('Item removed from inventory.');
    }
}
